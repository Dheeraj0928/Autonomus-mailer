# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Email Configuration (SMTP)
# For Gmail, set EMAIL_HOST=smtp.gmail.com and use a 16-character App Password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Your Name <your_email@gmail.com>

# For local testing without sending real emails, uncomment the line below:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
